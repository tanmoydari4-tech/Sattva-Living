rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tanmoydari4@gmail.com' ||
        request.auth.token.email == 'admin@sattvaliving.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection: PII isolated, users cannot elevate themselves to admin
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'member';
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Programs: public read, write admin only
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events: public read, write admin only
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enrollments: user can read own enrollments, admin can read/write all
    match /enrollments/{enrollmentId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Event Registrations: user can read own, admin can read all
    match /eventRegistrations/{regId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Habit Logs: private to user only
    match /habitLogs/{logId} {
      allow read, write: if (isSignedIn() && request.auth.uid == resource.data.userId) ||
                          (isSignedIn() && request.auth.uid == request.resource.data.userId);
    }

    // Articles: public read, admin write
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials: public read for approved, members can create pending, admin can moderate
    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Gallery: public read, admin write
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquiries: anyone can create, admin can read and update
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Payments: user can read own, admin can read/verify all
    match /payments/{paymentId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Settings: public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
